{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://admin-five-delta-84.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://admin-five-delta-84.vercel.app/admin/:path*"
    }
  ]
}
